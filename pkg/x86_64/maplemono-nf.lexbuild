{
  "kind": "recipe",
  "name": "maplemono-nf",
  "version": "7.9",
  "arch": ["x86_64"],
  "deps": [],
  "homepage": "https://github.com/subframe7536/maple-font",
  "description": "An Open Source Nerd Font For Developers.",
  "binary": {
    "url": "https://github.com/subframe7536/maple-font/releases/download/v7.9/MapleMono-NF.zip",
    "sha256": "59098b87c895d871635d37680e88000ae2b2b25b55428195b228ec589e35fb89",
    "install": [
      "mkdir -p $DESTDIR/usr/share/fonts",
      "cp ./*.ttf $DESTDIR/usr/share/fonts/",
      "fc-cache -fv"
    ]
  },
  "source": {
    "url": "https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/2.68.1.tar.gz",
    "sha256": "c268cfcd230cc7ed5447fb34ed21bf4977315c7104356a39388b6ba784ad11b0",
    "build": ["cmake -B build -DCMAKE_BUILD_TYPE=Release", "cmake --build build"],
    "install": ["DESTDIR=$DESTDIR cmake --install build"],
    "post_remove": ["ldconfig"]
  },
  "post_remove": ["ldconfig"]
}
