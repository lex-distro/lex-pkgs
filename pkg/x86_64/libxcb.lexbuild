{
  "kind": "recipe",
  "name": "libxcb",
  "version": "1.16",
  "arch": ["x86_64"],
  "deps": [],
  "homepage": "https://xorg.freedesktop.org",
  "description": "The libxcb package provides an interface to the X Window System protocol, which replaces the current Xlib interface. Xlib can also use XCB as a transport layer, allowing software to make requests and receive responses with both.",
  "source": {
    "url": "https://xorg.freedesktop.org/archive/individual/lib/libxcb-1.16.tar.xz",
    "sha256": "4348566aa0fbf196db5e0a576321c65966189210cb51328ea2bb2be39c711d71",
    "build": ["./configure $XORG_CONFIG      \
            --without-doxygen \
            --docdir='${datadir}'/doc/libxcb-1.16",
            "make"],
    "install": ["make install"],
    "post_remove": ["ldconfig"]
  },
  "post_remove": ["ldconfig"]
}
